<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.chaoxing.mobile" />
    </queries>

    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/app_description"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".LauncherActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".CourseBlockActivity"
            android:exported="false" />
        <activity
            android:name=".AboutActivity"
            android:exported="false" />
        <activity
            android:name=".BackupActivity"
            android:exported="false" />
        <activity
            android:name=".StatsActivity"
            android:exported="false" />
        <activity
            android:name=".ScheduleActivity"
            android:exported="false" />
        <activity
            android:name=".MonthCalendarActivity"
            android:exported="false" />
        <!-- Exported intentionally: the launcher starts this as the AppWidget configure
             activity. It only reads the widget id and writes module-local preferences. -->
        <activity
            android:name=".DeadlineWidgetConfigActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <service
            android:name=".DeadlineTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Exported intentionally: the hook runs inside Chaoxing's process and sends explicit
             broadcasts back to this module. DeadlineReceiver validates every non-system action
             with BridgeAuth before accepting data. -->
        <receiver
            android:name=".DeadlineReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Widget providers run in the module process and only read DeadlineStore;
             updates are pushed by the module itself, the launcher and the system. -->
        <receiver
            android:name=".DeadlineWidgetCompact"
            android:exported="false"
            android:label="@string/widget_compact_name"
            android:configure="dev.chaoxingdeadline.DeadlineWidgetConfigActivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>
        <receiver
            android:name=".DeadlineWidgetList"
            android:exported="false"
            android:label="@string/widget_list_name"
            android:configure="dev.chaoxingdeadline.DeadlineWidgetConfigActivity">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_list_info" />
        </receiver>
        <!-- 今日课程 widget: read-only view of the captured timetable. -->
        <receiver
            android:name=".DeadlineScheduleWidget"
            android:exported="false"
            android:label="@string/widget_schedule_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_info" />
        </receiver>
    </application>
</manifest>
